  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "import-trips": "node scripts/import-trips.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "android:apk": "cd android && ./gradlew assembleRelease",
    "build:apk": "npm run import-trips && npx expo prebuild -p android --clean && cd android && ./gradlew assembleRelease",
    "ship": "npm run import-trips && npx eas-cli@latest update --channel production --environment production --platform android --message",
    "build:apk:test": "npm run import-trips && APP_VARIANT=test npx expo prebuild -p android --clean && cd android && ./gradlew assembleRelease",
    "ship:test": "npm run import-trips && APP_VARIANT=test npx eas-cli@latest update --channel test --environment preview --platform android --message",
    "upload-docs": "node --env-file=.env scripts/upload-docs.mjs",
    "db": "node --env-file=.env --env-file=.env.admin scripts/db.mjs"
  },
  "private": true,
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
